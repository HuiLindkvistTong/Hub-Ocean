import os
import matplotlib.pyplot as plt
import pandas as pd
from pandas.api.types import is_list_like
from odp.client import Client
from odp.catalog_v2 import create_dataset_meta
import geopandas as gpd
import webbrowser

api_key = os.getenv("ODP_API_KEY")
if not api_key:
    raise RuntimeError("Set the ODP_API_KEY environment variable before running this script.")

cli = Client(api_key=api_key)
glodap = cli.dataset("a608f54b-75c7-4df9-a3a8-cedbfa391873")
table = glodap.table


# import pyarrow as pa

# schema = table.schema()
# print(schema)

# as Pandas or GeoPandas df
# cursor = table.select().dataframes()
# df = next(cursor)
# print (df.head())   


# Geospatial filter based on the updated polygon coordinates for Canada
filter_expr = (
    'geometry within "POLYGON ((-180.9739 72.3175, 0.3049 67.4165, '
    '-50.862 36.0707, -111.3841 45.1457, -180.9739 72.3175))"'
)
df_filtered = table.select(filter=filter_expr).all().dataframe()
all_null_columns = df_filtered.columns[df_filtered.isna().all()].tolist()

if all_null_columns:
    df_filtered = df_filtered.drop(columns=all_null_columns)
    print(f"Skipping columns with no values: {all_null_columns}")

print(df_filtered.head())

if df_filtered.empty:
    raise ValueError("The geographic filter returned no rows; stopping before upload.")


new_ds_id_1 = "39946cbb-4c51-4c31-9419-363f01885fa6"   # paste an existing dataset id here to reuse it
created_new_dataset_1 = False

if not new_ds_id_1:
    created = create_dataset_meta(
        cli,
        name="ProtectedSeas Navigator V2-Canada",
        description=(
            "ProtectedSeas Navigator V2 — Focused: Area-Based Protections in Canada. Created during the Capstone module."
        ),
    )
    new_ds_id_1 = created.id
    created_new_dataset_1 = True

out_tbl = cli.dataset(new_ds_id_1).table
new_ds_id_1    

print(f"New dataset for ProtectedSeas Navigator V2-Canada created with ID: {new_ds_id_1}")

print(f"Uploaded {len(df_filtered)} rows.")
print(f"Hub Ocean now has {out_tbl.stats().num_rows} rows.")


